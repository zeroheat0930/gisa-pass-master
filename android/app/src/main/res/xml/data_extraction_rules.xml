<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ 용. backup_rules.xml 과 같은 이유로 프리미엄 구매 캐시를 제외한다.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="FlutterSharedPreferences.xml"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="FlutterSharedPreferences.xml"/>
    </device-transfer>
</data-extraction-rules>
