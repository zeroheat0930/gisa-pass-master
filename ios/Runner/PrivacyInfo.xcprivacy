<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- 이 앱은 ATT 동의를 받아 IDFA 기반 맞춤 광고(AdMob)를 사용한다.
       예전에는 여기가 false 로 되어 있어 매니페스트가 앱의 실제 동작과 모순됐다
       (ATT 프롬프트를 띄우면서 "추적 안 함" 선언). 심사 리젝 사유이자
       개인정보 라벨 불일치다. -->
  <key>NSPrivacyTracking</key>
  <true/>
  <!-- NSPrivacyTrackingDomains 는 **일부러 넣지 않는다.**

       빈 배열(<array/>)로 두었더니 애플이 빌드를 반려했다 —
       ITMS-91064 "잘못된 추적 정보". 키가 있으면 값이 있어야 한다.

       그렇다고 광고 도메인을 채워 넣으면 안 된다. 여기 적힌 도메인은
       **ATT 를 거부한 사용자에게 iOS 가 연결 자체를 차단한다.** AdMob 은
       맞춤형 광고든 비맞춤형 광고든 같은 도메인으로 서빙하므로, 도메인을
       적으면 거부한 사용자에게 광고가 아예 안 나가고 그만큼 수익이 사라진다.

       이 앱이 추적 목적으로 직접 접속하는 도메인은 없다. 추적은 전적으로
       Google Mobile Ads SDK 안에서 일어나고, 그 SDK 는 자기 프라이버시
       매니페스트를 프레임워크에 함께 넣어 배포한다. 그러므로 키를 생략하는
       것이 사실에도 맞고 규격에도 맞다.

       NSPrivacyTracking 자체는 true 로 남긴다 — ATT 프롬프트를 띄우고
       IDFA 로 맞춤형 광고를 하므로 추적이 맞다. -->
  <key>NSPrivacyCollectedDataTypes</key>
  <array>
    <!-- IDFA (기기 식별자) — 제3자 광고 목적, 추적에 사용 -->
    <dict>
      <key>NSPrivacyCollectedDataType</key>
      <string>NSPrivacyCollectedDataTypeDeviceID</string>
      <key>NSPrivacyCollectedDataTypeLinked</key>
      <false/>
      <key>NSPrivacyCollectedDataTypeTracking</key>
      <true/>
      <key>NSPrivacyCollectedDataTypePurposes</key>
      <array>
        <string>NSPrivacyCollectedDataTypePurposeThirdPartyAdvertising</string>
      </array>
    </dict>
    <!-- 광고 상호작용 데이터 (AdMob) -->
    <dict>
      <key>NSPrivacyCollectedDataType</key>
      <string>NSPrivacyCollectedDataTypeAdvertisingData</string>
      <key>NSPrivacyCollectedDataTypeLinked</key>
      <false/>
      <key>NSPrivacyCollectedDataTypeTracking</key>
      <true/>
      <key>NSPrivacyCollectedDataTypePurposes</key>
      <array>
        <string>NSPrivacyCollectedDataTypePurposeThirdPartyAdvertising</string>
      </array>
    </dict>
    <!-- 인앱결제 이력 (프리미엄 구매) — 추적 아님 -->
    <dict>
      <key>NSPrivacyCollectedDataType</key>
      <string>NSPrivacyCollectedDataTypePurchaseHistory</string>
      <key>NSPrivacyCollectedDataTypeLinked</key>
      <false/>
      <key>NSPrivacyCollectedDataTypeTracking</key>
      <false/>
      <key>NSPrivacyCollectedDataTypePurposes</key>
      <array>
        <string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
      </array>
    </dict>
  </array>
  <key>NSPrivacyAccessedAPITypes</key>
  <array>
    <dict>
      <key>NSPrivacyAccessedAPIType</key>
      <string>NSPrivacyAccessedAPICategoryUserDefaults</string>
      <key>NSPrivacyAccessedAPITypeReasons</key>
      <array>
        <string>CA92.1</string>
      </array>
    </dict>
  </array>
</dict>
</plist>
